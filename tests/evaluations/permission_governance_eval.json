{
  "schema_version": 1,
  "name": "SuperAgent 权限治理评测集",
  "updated_at": "2026-08-01",
  "base_url": "http://127.0.0.1:8001",
  "notes": [
    "先使用 start-superagent-governance.ps1 启动治理模式。",
    "ALLOW 表示可直接执行；REVIEW_REQUIRED 表示必须由治理审核人批准；DENY 表示禁止。",
    "可信 grants=all/system_orchestrator 属性在底层统一授权全部已注册 Agent 和工具，不依赖用户名；普通用户仍执行完整权限规则。",
    "本评测集不包含任何模型不可用降级。"
  ],
  "cases": [
    {
      "id": "PG-API-001",
      "category": "agent_dispatch",
      "title": "管理员查询风险 Agent",
      "automated": true,
      "request": {
        "method": "GET",
        "path": "/api/security/check",
        "params": {
          "user_id": "admin",
          "agent_name": "RemoteBusinessRiskAgent",
          "action": "query"
        }
      },
      "expected": {
        "http_status": 200,
        "json": {
          "decision": "ALLOW",
          "allowed": true,
          "available_to_user": true
        }
      }
    },
    {
      "id": "PG-API-002",
      "category": "mandatory_review",
      "title": "HR 经理查询工资需要审批",
      "automated": true,
      "request": {
        "method": "GET",
        "path": "/api/security/tool-check",
        "params": {
          "user_id": "hr_manager",
          "tool_name": "remote_salary_info_tool"
        }
      },
      "expected": {
        "http_status": 200,
        "json": {
          "decision": "REVIEW_REQUIRED",
          "allowed": false,
          "eligible": true,
          "review_required": true
        }
      }
    },
    {
      "id": "PG-API-003",
      "category": "grant_denial",
