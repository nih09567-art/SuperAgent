      "id": "ORCH-006",
      "tier": "core",
      "category": "invalid_cycle_rejection",
      "purpose": "验证 Planner 草案形成环时在 Scheduler 执行前拒绝",
      "evaluation_mode": "candidate_plan_validation",
      "workflow_template": "annual_leave_three",
      "query": "查询王强的岗位、工龄和年假政策，生成 Markdown 汇总。",
      "setup": {
        "candidate_plan_mutation": {
