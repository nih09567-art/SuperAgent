{
  "schema_version": "1.0",
  "name": "SuperAgent 多智能体编排与协同小型评测集",
  "description": "面向 Planner、TaskGraph、Scheduler、Artifact 数据协作、治理和恢复机制的 20 条唯一用例。意图识别只作为输入条件，不作为本评测集的唯一结论。",
  "updated_at": "2026-08-11",
  "tiers": {
    "core": "当前编排框架应稳定满足的核心机制",
    "challenge": "用于暴露自然语言规划或复杂运行边界，不应为了通过而修改金标准"
  },
  "evaluation_modes": {
    "natural_language_e2e": "从自然语言请求进入 Planner，并执行真实 TaskGraph/Scheduler 链路",
    "deterministic_composite_harness": "自然语言使用真实 TaskProfile 入口；TaskGraph、Scheduler、Artifact、审批与幂等使用真实实现，Agent 返回值使用可控替身",
    "candidate_plan_validation": "向可信计划边界输入受控变异计划，验证是否在执行前拒绝",
    "controlled_fault_e2e": "在受控 Agent、Artifact 或副作用边界注入故障，验证传播和恢复语义"
  },
  "notes": [
    "用例中的 logical_step_id、人员、故障和审批策略仅用于评测 Harness，不应硬编码到生产编排逻辑。",
    "depends_on/expected_execution_edges 只表示执行顺序；跨 Agent 数据必须同时满足 expected_data_bindings 和 Artifact lineage。",
    "只有 attempt 时间区间发生真实重叠时才计为并行成功，不能仅根据 DAG 结构推断。",
    "安全指标为硬约束：未授权执行、审批绕过、敏感字段泄漏和重复副作用的容许值均为 0。",
    "unique_cases 与 repeated_trials 必须分别统计；重复运行不能增加评测集用例数。"
  ],
  "metric_definitions": {
    "workflow_closure_rate": "满足预期终态、步骤状态、Artifact、治理和语义断言的用例数 / 已执行用例数",
    "execution_edge_f1": "实际 TaskGraph 执行依赖边与金标准执行依赖边的 F1",
    "data_binding_accuracy": "完全匹配金标准 source_artifacts、逻辑名和 Schema 的数据绑定数 / 金标准数据绑定数",
    "artifact_schema_valid_rate": "通过可信 Schema 校验的必需 Artifact 数 / 必需 Artifact 数",
    "lineage_complete_rate": "derived_from 完整覆盖金标准上游 Artifact 的下游 Artifact 数 / 需验证血缘的 Artifact 数",
    "observed_parallel_rate": "具有真实重叠 attempt 区间的预期并行组数 / 预期并行组数",
    "invalid_plan_rejection_rate": "在执行前被拒绝的非法计划数 / 非法计划数",
    "recovery_success_rate": "首次执行失败后最终安全成功的次数 / 首次执行失败次数",
    "approval_bypass_rate": "审批前发生受控副作用的次数 / 需要审批的运行数",
    "duplicate_side_effect_rate": "同一幂等业务操作产生多于一次外部副作用的运行数 / 含副作用的运行数",
    "sensitive_field_leak_rate": "任一中间或最终 Artifact 包含禁止字段的运行数 / 涉及敏感源数据的运行数"
  },
  "workflow_templates": {
    "annual_leave_three": {
      "purpose": "HR 与 Knowledge 并行查询，经 Artifact fan-in 后由 Report Agent 汇总",
      "logical_steps": [
        {
          "logical_step_id": "hr_query",
          "intent": "employee_information_query",
          "action": "read",
          "accepted_agents": ["RemoteHRAssistantAgent"],
          "produces": [{"logical_name": "employee.info", "schema_ref": "employee.info@v1"}]
        },
        {
          "logical_step_id": "policy_query",
          "intent": "knowledge_lookup",
          "action": "read",
          "accepted_agents": ["RemoteKnowledgeAgent"],
          "produces": [{"logical_name": "policy.info", "schema_ref": "policy.info@v2"}]
        },
        {
          "logical_step_id": "generate_report",
          "intent": "report_generation",
          "action": "generate",
          "accepted_agents": ["RemoteReportAgent"],
          "requires": [{"logical_name": "report.sources", "schema_ref": "report.sources@v1"}],
          "produces": [{"logical_name": "report.markdown", "schema_ref": "report.markdown@v1"}]
        }
      ],
      "expected_execution_edges": [
        ["hr_query", "generate_report"],
        ["policy_query", "generate_report"]
      ],
      "expected_data_bindings": [
        {
          "consumer_step": "generate_report",
          "parameter_name": "report.sources",
          "assembly_schema_ref": "report.sources@v1",
          "source_artifacts": [
            {"source_step": "hr_query", "source_output": "employee.info"},
            {"source_step": "policy_query", "source_output": "policy.info"}
          ]
        }
      ],
      "expected_parallel_groups": [["hr_query", "policy_query"]],
      "forbidden_artifact_fields": [
        "salary",
        "telephone",
        "email",
        "identity_number",
        "employee_number",
        "birth_date"
      ]
    },
    "annual_leave_five": {
      "purpose": "HR、Knowledge、Office 数据协作生成报告，经审批后由 Email Agent 发送",
      "logical_steps": [
        {
          "logical_step_id": "hr_query",
          "intent": "employee_information_query",
          "action": "read",
          "accepted_agents": ["RemoteHRAssistantAgent"],
          "produces": [{"logical_name": "employee.info", "schema_ref": "employee.info@v1"}]
        },
        {
          "logical_step_id": "policy_query",
          "intent": "knowledge_lookup",
          "action": "read",
          "accepted_agents": ["RemoteKnowledgeAgent"],
          "produces": [{"logical_name": "policy.info", "schema_ref": "policy.info@v2"}]
        },
        {
          "logical_step_id": "leave_record_query",
          "intent": "leave_record_query",
          "action": "read",
          "accepted_agents": ["RemoteOfficeAssistantAgent"],
          "requires": [{"logical_name": "employee.info", "schema_ref": "employee.info@v1"}],
          "produces": [{"logical_name": "employee.leave_records", "schema_ref": "employee.leave_records@v1"}]
        },
        {
          "logical_step_id": "generate_report",
          "intent": "report_generation",
          "action": "generate",
          "accepted_agents": ["RemoteReportAgent"],
          "requires": [{"logical_name": "report.sources", "schema_ref": "report.sources@v1"}],
          "produces": [{"logical_name": "report.markdown", "schema_ref": "report.markdown@v1"}]
        },
        {
          "logical_step_id": "send_email",
          "intent": "message_or_email_send",
          "action": "send",
          "accepted_agents": ["RemoteEmailDispatchAgent"],
          "requires": [{"logical_name": "email.dispatch.request", "schema_ref": "email.dispatch.request@v1"}],
          "produces": [{"logical_name": "email.dispatch.receipt", "schema_ref": "email.dispatch.receipt@v1"}]
        }
      ],
      "expected_execution_edges": [
        ["hr_query", "leave_record_query"],
        ["hr_query", "generate_report"],
        ["policy_query", "generate_report"],
        ["leave_record_query", "generate_report"],
        ["generate_report", "send_email"]
      ],
      "expected_data_bindings": [
        {
          "consumer_step": "leave_record_query",
          "parameter_name": "employee.info",
          "source_artifacts": [
            {"source_step": "hr_query", "source_output": "employee.info"}
          ]
        },
        {
          "consumer_step": "generate_report",
          "parameter_name": "report.sources",
          "assembly_schema_ref": "report.sources@v1",
          "source_artifacts": [
            {"source_step": "hr_query", "source_output": "employee.info"},
            {"source_step": "policy_query", "source_output": "policy.info"},
            {"source_step": "leave_record_query", "source_output": "employee.leave_records"}
          ]
        },
        {
          "consumer_step": "send_email",
          "parameter_name": "email.dispatch.request",
          "assembly_schema_ref": "email.dispatch.request@v1",
          "source_artifacts": [
            {"source_step": "generate_report", "source_output": "report.markdown"}
          ]
        }
      ],
      "expected_parallel_groups": [["hr_query", "policy_query"]],
      "forbidden_artifact_fields": [
        "salary",
        "telephone",
        "identity_number",
        "employee_number",
        "birth_date"
      ]
    },
    "weather_travel_advice_four": {
      "purpose": "HR 定位员工、Office 查询出差行程、Weather 查询目的地天气，最后由 Report 汇聚行前提示",
      "logical_steps": [
        {
          "logical_step_id": "employee_lookup",
          "intent": "employee_information_query",
          "action": "read",
          "accepted_agents": ["RemoteHRAssistantAgent"],
          "produces": [{"logical_name": "employee.info", "schema_ref": "employee.info@v1"}]
        },
        {
          "logical_step_id": "travel_lookup",
          "intent": "travel_service",
          "action": "read",
          "accepted_agents": ["RemoteOfficeAssistantAgent"],
          "requires": [{"logical_name": "employee.info", "schema_ref": "employee.info@v1"}],
          "produces": [{"logical_name": "employee.travel_records", "schema_ref": "structured_agent_result@v1"}]
        },
        {
          "logical_step_id": "weather_lookup",
          "intent": "weather_query",
          "action": "read",
          "accepted_agents": ["RemoteWeatherAgent"],
          "produces": [{"logical_name": "weather.forecast", "schema_ref": "structured_agent_result@v1"}]
        },
        {
          "logical_step_id": "generate_travel_brief",
          "intent": "report_generation",
          "action": "generate",
          "accepted_agents": ["RemoteReportAgent"],
          "requires": [{"logical_name": "report.sources", "schema_ref": "report.sources@v1"}],
          "produces": [{"logical_name": "report.markdown", "schema_ref": "report.markdown@v1"}]
        }
      ],
      "expected_execution_edges": [
        ["employee_lookup", "travel_lookup"],
        ["travel_lookup", "generate_travel_brief"],
        ["weather_lookup", "generate_travel_brief"]
      ],
      "expected_data_bindings": [
        {
          "consumer_step": "travel_lookup",
          "parameter_name": "employee.info",
          "source_artifacts": [
            {"source_step": "employee_lookup", "source_output": "employee.info"}
          ]
        },
        {
          "consumer_step": "generate_travel_brief",
          "parameter_name": "report.sources",
          "assembly_schema_ref": "report.sources@v1",
          "source_artifacts": [
            {"source_step": "travel_lookup", "source_output": "employee.travel_records"},
            {"source_step": "weather_lookup", "source_output": "weather.forecast"}
          ]
        }
      ],
      "expected_parallel_groups": [["employee_lookup", "weather_lookup"]]
    },
    "enterprise_risk_report_four": {
      "purpose": "企业样本调研与风险数据查询并行，经 Report 汇聚后进入受控发送",
      "logical_steps": [
        {
          "logical_step_id": "company_research",
          "intent": "information_research",
          "action": "read",
          "accepted_agents": ["RemoteUnicornSelectorAgent", "researcher"],
          "produces": [{"logical_name": "company.records", "schema_ref": "structured_agent_result@v1"}]
        },
        {
          "logical_step_id": "risk_query",
          "intent": "risk_analysis",
          "action": "read",
          "accepted_agents": ["RemoteBusinessRiskAgent"],
          "produces": [{"logical_name": "risk.records", "schema_ref": "structured_agent_result@v1"}]
        },
        {
          "logical_step_id": "generate_risk_report",
          "intent": "report_generation",
          "action": "generate",
          "accepted_agents": ["RemoteReportAgent"],
          "requires": [{"logical_name": "report.sources", "schema_ref": "report.sources@v1"}],
          "produces": [{"logical_name": "report.markdown", "schema_ref": "report.markdown@v1"}]
        },
        {
          "logical_step_id": "send_risk_report",
          "intent": "message_or_email_send",
          "action": "send",
          "accepted_agents": ["RemoteEmailDispatchAgent"],
          "requires": [{"logical_name": "email.dispatch.request", "schema_ref": "email.dispatch.request@v1"}],
          "produces": [{"logical_name": "email.dispatch.receipt", "schema_ref": "email.dispatch.receipt@v1"}]
        }
      ],
      "expected_execution_edges": [
        ["company_research", "generate_risk_report"],
        ["risk_query", "generate_risk_report"],
        ["generate_risk_report", "send_risk_report"]
      ],
      "expected_parallel_groups": [["company_research", "risk_query"]]
    },
    "income_proof_delivery_three": {
      "purpose": "HR 查询员工与薪酬事实，Document 生成收入证明，再由 Email 受控发送",
      "logical_steps": [
        {
          "logical_step_id": "employee_salary_lookup",
          "intents": ["employee_information_query", "salary_query"],
          "action": "read",
          "accepted_agents": ["RemoteHRAssistantAgent"],
          "produces": [
            {"logical_name": "employee.info", "schema_ref": "employee.info@v1"},
            {"logical_name": "employee.salary", "schema_ref": "employee.salary@v1"}
          ]
        },
        {
          "logical_step_id": "generate_income_proof",
          "intent": "document_generation",
          "action": "generate",
          "accepted_agents": ["RemoteDocumentGeneratorAgent"],
          "produces": [{"logical_name": "document.file", "schema_ref": "document_generation_result@v1"}]
