          "logical_step_id": "send_income_proof",
          "intent": "message_or_email_send",
          "action": "send",
          "accepted_agents": ["RemoteEmailDispatchAgent"],
          "requires": [{"logical_name": "email.dispatch.request", "schema_ref": "email.dispatch.request@v1"}],
          "produces": [{"logical_name": "email.dispatch.receipt", "schema_ref": "email.dispatch.receipt@v1"}]
        }
      ],
      "expected_execution_edges": [
        ["employee_salary_lookup", "generate_income_proof"],
        ["generate_income_proof", "send_income_proof"]
      ]
