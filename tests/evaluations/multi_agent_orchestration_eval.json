      "expected": {
        "plan_accepted": true,
        "workflow_status": "PARTIAL_FAILED",
        "step_statuses": {
          "hr_query": "SUCCEEDED",
          "policy_query": "FAILED",
          "generate_report": "SKIPPED"
        },
        "required_artifacts": ["employee.info"],
        "forbidden_artifacts": ["policy.info", "report.markdown"],
        "failure_descriptor_required": true,
        "failure_descriptor_must_be_safe": true,
        "max_side_effect_invocations": 0
      }
    },
