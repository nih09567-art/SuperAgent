    {
      "id": "ORCH-007",
      "tier": "core",
      "category": "missing_fanin_binding_rejection",
      "purpose": "验证 Report 声称需要多源数据但缺少 policy.info 绑定时失败关闭",
      "evaluation_mode": "candidate_plan_validation",
      "workflow_template": "annual_leave_three",
      "query": "查询王强的岗位、工龄和年假政策，生成 Markdown 汇总。",
      "setup": {
        "candidate_plan_mutation": {
          "type": "remove_source_artifact",
          "consumer_step": "generate_report",
          "parameter_name": "report.sources",
          "source_output": "policy.info"
        }
