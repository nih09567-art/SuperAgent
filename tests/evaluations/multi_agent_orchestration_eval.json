    "conditional_meeting_notification_three": {
      "purpose": "先查询日程，仅在满足空闲条件时创建会议，并在会议成功后通知参与人",
      "logical_steps": [
        {
          "logical_step_id": "schedule_query",
          "intent": "schedule_management",
          "action": "read",
          "accepted_agents": ["RemoteScheduleAgent", "RemoteHRCalendarAgent"],
          "produces": [{"logical_name": "schedule.result", "schema_ref": "structured_agent_result@v1"}]
        },
        {
          "logical_step_id": "arrange_meeting",
          "intent": "meeting_arrangement",
          "action": "write",
          "accepted_agents": ["RemoteMeetingManagerAgent"],
          "requires": [{"logical_name": "schedule.result", "schema_ref": "structured_agent_result@v1"}],
          "produces": [{"logical_name": "meeting.result", "schema_ref": "structured_agent_result@v1"}]
        },
        {
          "logical_step_id": "notify_participants",
          "intent": "message_or_email_send",
          "action": "send",
          "accepted_agents": ["RemoteCommunicationAgent"],
          "requires": [{"logical_name": "meeting.result", "schema_ref": "structured_agent_result@v1"}],
          "produces": [{"logical_name": "communication.result", "schema_ref": "communication_result@v1"}]
        }
      ],
      "expected_execution_edges": [
        ["schedule_query", "arrange_meeting"],
        ["arrange_meeting", "notify_participants"]
      ]
    }
  },
  "cases": [
    {
      "id": "ORCH-001",
      "tier": "core",
      "category": "parallel_fanin_success",
      "purpose": "验证三 Agent 并行查询、Artifact fan-in、Schema 和最终报告血缘",
      "evaluation_mode": "natural_language_e2e",
      "workflow_template": "annual_leave_three",
      "query": "请查询员工王强的在职状态、岗位和累计工龄，并依据国务院关于职工带薪年休假的规定，判断其年假天数，生成一份 Markdown 汇总。",
      "setup": {"fault_injection": null},
      "expected": {
        "plan_accepted": true,
        "workflow_status": "SUCCEEDED",
        "step_statuses": {
          "hr_query": "SUCCEEDED",
          "policy_query": "SUCCEEDED",
          "generate_report": "SUCCEEDED"
        },
        "required_artifacts": ["employee.info", "policy.info", "report.markdown"],
        "forbidden_artifacts": [],
        "all_required_artifact_schemas_valid": true,
        "lineage": {"report.markdown": ["employee.info", "policy.info"]},
        "observed_parallel_groups": [["hr_query", "policy_query"]],
        "max_side_effect_invocations": 0
      }
    },
    {
      "id": "ORCH-002",
      "tier": "challenge",
      "category": "semantic_paraphrase_same_graph",
      "purpose": "验证口语化表达不会改变三 Agent 协作拓扑或误触发文档与发送 Agent",
      "evaluation_mode": "natural_language_e2e",
      "workflow_template": "annual_leave_three",
      "query": "帮我看看王强能休几天年假：查一下他的岗位和工龄，再对照年休假规定，最后把结论整理成页面里的 Markdown，别生成 Word，也别发出去。",
      "setup": {"fault_injection": null},
      "expected": {
        "plan_accepted": true,
        "required_intents": ["employee_information_query", "knowledge_lookup", "report_generation"],
        "forbidden_executable_intents": ["document_generation", "message_or_email_send"],
        "workflow_status": "SUCCEEDED",
        "required_artifacts": ["employee.info", "policy.info", "report.markdown"],
        "forbidden_artifacts": ["document.file", "email.dispatch.receipt"],
        "lineage": {"report.markdown": ["employee.info", "policy.info"]},
        "observed_parallel_groups": [["hr_query", "policy_query"]],
        "max_side_effect_invocations": 0
      }
    },
    {
      "id": "ORCH-003",
      "tier": "core",
      "category": "valid_not_found_semantics",
      "purpose": "验证合法的未检索到制度结果仍可进入 Report，但报告不得编造年假天数",
      "evaluation_mode": "controlled_fault_e2e",
      "workflow_template": "annual_leave_three",
      "query": "查询王强的岗位和工龄，并根据年假制度生成 Markdown 结论。",
      "setup": {
        "fault_injection": {
          "target_step": "policy_query",
          "type": "valid_not_found_artifact",
          "artifact": {"logical_name": "policy.info", "schema_ref": "policy.info@v2", "not_found": true}
        }
      },
      "expected": {
        "plan_accepted": true,
        "workflow_status": "SUCCEEDED",
        "step_statuses": {
          "hr_query": "SUCCEEDED",
          "policy_query": "SUCCEEDED",
          "generate_report": "SUCCEEDED"
        },
        "required_artifacts": ["employee.info", "policy.info", "report.markdown"],
        "semantic_assertions": [
          "report_states_no_valid_policy_basis",
          "report_does_not_infer_leave_days"
        ],
        "max_side_effect_invocations": 0
      }
    },
    {
      "id": "ORCH-004",
      "tier": "core",
      "category": "upstream_failure_propagation",
      "purpose": "验证 Knowledge Agent HTTP 失败后 Report 正确跳过且不产生伪造结果",
      "evaluation_mode": "controlled_fault_e2e",
      "workflow_template": "annual_leave_three",
      "query": "查询王强的岗位、工龄和年假政策，生成 Markdown 汇总。",
