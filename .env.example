# SuperAgent 团队统一配置（Python 3.12）
# 将本文件复制为 .env，并在本机填写真实 API Key；禁止提交 .env。

# 复杂规划与推理
REASONING_API_KEY=
REASONING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REASONING_MODEL=qwen3.5-27b

# 普通任务
BASIC_API_KEY=
BASIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BASIC_MODEL=qwen3.5-27b

# 代码任务
CODE_API_KEY=
CODE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CODE_MODEL=deepseek-v4-flash

# 视觉任务
VL_API_KEY=
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen3.5-27b

# 本地远程 Agent Demo
REMOTE_API_KEY=
REMOTE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REMOTE_MODEL=qwen3.5-27b
REMOTE_LLM_TEMPERATURE=0.1
REMOTE_LLM_MAX_TOKENS=2000
REMOTE_EXTRACTION_TIMEOUT=30
REMOTE_TOOL_TIMEOUT=120
REMOTE_REPORT_LLM_TIMEOUT=120
REMOTE_REPORT_TOOL_TIMEOUT=150

# 应用开关
APP_ENV=development
DEBUG=false
ANONYMIZED_TELEMETRY=false
USE_BROWSER=false
USE_MCP_TOOLS=false
MCP_AGENT=false
# Subject/Object/Scenario/Action 权限校验：原型推荐配置默认开启。
# 治理 Artifact 读取、工具调用和 Agent 调度；演示用户见 config/s_abac_demo_users.py。
# 代码缺省值仍为 false，未知用户和策略异常保持 fail-closed。
S_ABAC_ENABLED=true

# 执行引擎特性开关
# ARTIFACT_CAPTURE_ENABLED：旧 publisher/while 路径的兼容捕获仍关闭；
#   调度器 Artifact 持久化由 scheduler runtime 独立完成。
# ORCHESTRATION_SCHEDULER_ENABLED：原型推荐配置默认开启；代码缺省值仍为 false。
#   开启后：图就绪→进入调度器；规划阶段无图→仍走旧 publisher/while；
#   生产执行阶段缺图、快照校验失败或图非法→直接失败（fail-closed）。
# SCHEDULER_REDISPATCH_ENABLED：只读步骤重试耗尽后最多改派一次，默认关闭。
# SCHEDULER_RETRY_DELAY_SECONDS：同 Agent 可重试失败后的固定等待秒数，默认 0。
ARTIFACT_CAPTURE_ENABLED=false
ORCHESTRATION_SCHEDULER_ENABLED=true
SCHEDULER_REDISPATCH_ENABLED=false
SCHEDULER_RETRY_DELAY_SECONDS=0

# 治理事件和人工审批持久化目录。默认分别为 store/governance 与
# store/approvals；通常无需修改，测试或多实例隔离时可显式配置。
# GOVERNANCE_EVENT_STORE_DIR=store/governance
# APPROVAL_STORE_DIR=store/approvals
# RECONCILIATION_STORE_DIR=store/reconciliations

# Scheduler 分级恢复。普通启动默认关闭；治理演示脚本显式启用。
# AUTO_RECOVERY_ENABLED=false
# SCHEDULER_AUTO_RECOVERY_MAX_ATTEMPTS=1
# SCHEDULER_RETRY_BASE_SECONDS=0.25
# SCHEDULER_RETRY_MAX_SECONDS=4
# SCHEDULER_RETRY_JITTER_RATIO=0.2

# Artifact 保护存储（原型：仅隔离 + 校验和 + 权限守卫 + 审计，未做静态加密）
# ARTIFACT_PAYLOAD_STORE_DIR：受保护 Artifact payload 落盘目录（与通用 checkpoint 隔离）
# ARTIFACT_PAYLOAD_TTL_SECONDS：payload 保留期（秒），运行时按此 TTL 定期清理，默认 7 天
# ARTIFACT_AUDIT_LOG：Artifact 读取放行/拒绝审计日志（仅元数据，绝不含 payload/URI）
ARTIFACT_PAYLOAD_STORE_DIR=store/artifacts
ARTIFACT_PAYLOAD_TTL_SECONDS=604800
ARTIFACT_AUDIT_LOG=store/audit/artifact_access.jsonl

# 意图识别：rule / hybrid / semantic。hybrid 默认复用 BASIC_* 模型配置。
INTENT_RECOGNITION_MODE=hybrid
INTENT_RULE_STRONG_THRESHOLD=0.82
INTENT_SEMANTIC_ACCEPT_THRESHOLD=0.72
INTENT_SEMANTIC_HIGH_RISK_THRESHOLD=0.85
INTENT_AGREEMENT_BONUS=0.06
INTENT_CONFLICT_THRESHOLD=0.75
INTENT_SEMANTIC_TIMEOUT_SECONDS=20
# 仅在本轮需要结合结构化对话上下文时使用，避免普通请求被额外放慢。
INTENT_CONTEXT_SEMANTIC_TIMEOUT_SECONDS=35

# 搜索服务（可选；未配置时页面会自动禁用搜索）
TAVILY_API_KEY=
JINA_API_KEY=

# Durable Agent Memory
MEMORY_ENABLED=True
MEMORY_LONG_TERM_ENABLED=True
MEMORY_AUTO_COMPACT_ENABLED=True
MEMORY_COMPACTION_LLM_ENABLED=False
MEMORY_MAX_CONTEXT_TOKENS=32768
MEMORY_RESERVED_OUTPUT_TOKENS=4096
MEMORY_COMPACTION_TRIGGER_RATIO=0.75
MEMORY_LONG_TERM_TOP_K=5
MEMORY_MAX_RECORD_CHARS=8000
MEMORY_ALLOW_REMOTE_LONG_TERM=False
# MEMORY_STORE_DIR=store/memory

# Reusable workflow skills (distilled from successful Production runs)
WORKFLOW_SKILL_ENABLED=True
WORKFLOW_SKILL_REUSE_ENABLED=True
WORKFLOW_SKILL_AUTO_DISTILL_ENABLED=True
WORKFLOW_SKILL_MATCH_THRESHOLD=0.62
WORKFLOW_SKILL_MATCH_MARGIN=0.08
WORKFLOW_SKILL_PROMOTION_THRESHOLD=2
WORKFLOW_SKILL_FAILURE_THRESHOLD=2
# WORKFLOW_SKILL_DB_PATH=store/skills/workflow_skills.sqlite3
# WORKFLOW_SKILL_ADMIN_API_KEY=set-a-strong-random-token

# Server-owned trusted principal recorded for approval and reconciliation actions.
GOVERNANCE_ADMIN_ACTOR_ID=admin
